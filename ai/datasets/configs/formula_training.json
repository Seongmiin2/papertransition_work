{
  "baseline": {
    "layout_model": "PP-DocLayout-S",
    "recognition_model": "PP-FormulaNet_plus-S",
    "layout_threshold": 0.3,
    "enable_mkldnn_on_cpu": false
  },
  "data_gates": {
    "minimum_verified_formulas": 3000,
    "minimum_unique_documents": 50,
    "minimum_validation_formulas": 500,
    "minimum_test_formulas": 500,
    "split_unit": "document_id"
  },
  "fine_tuning": {
    "input_height": 384,
    "max_width": 1536,
    "batch_size": 4,
    "gradient_accumulation_steps": 4,
    "learning_rate": 0.0001,
    "weight_decay": 0.01,
    "warmup_ratio": 0.05,
    "max_epochs": 20,
    "early_stopping_patience": 3,
    "gradient_clip_norm": 1.0,
    "mixed_precision": "fp16",
    "seed": 20260821
  },
  "augmentation": {
    "deskew_degrees": 1.5,
    "scale_range": [0.85, 1.15],
    "jpeg_quality_range": [55, 100],
    "gaussian_blur_probability": 0.2,
    "color_annotation_probability": 0.2,
    "perspective_probability": 0.1
  },
  "quality_gates": {
    "exact_match_minimum": 0.9,
    "normalized_edit_similarity_minimum": 0.97,
    "formula_detection_recall_minimum": 0.98,
    "hwpx_roundtrip_open_rate": 1.0
  }
}
